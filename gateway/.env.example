# Spring Boot gateway environment.
# Set these in your host's dashboard (Render/Railway). Required for production.

# Render provides PORT automatically, but this keeps local runs explicit.
PORT=8080

# URL of the deployed Python ML service (no trailing slash)
INFERENCE_URL=https://your-ml-service.example.com

# Allowed browser origin = your deployed frontend URL
CORS_ORIGINS=https://your-frontend.vercel.app

# A long random secret (>= 32 chars) used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# --- MySQL (only when running with --spring.profiles.active=prod) ---
MYSQL_HOST=your-db-host
MYSQL_PORT=3306
MYSQL_DB=dermacare
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password
